// OpenCode configuration — replaces omp/mcp.json. See https://opencode.ai/docs/config/
{
  "$schema": "https://opencode.ai/config.json",
  // Token optimization: compact earlier and keep less recent history than the
  // defaults, so long build/review sessions stay cheap without losing decisions.
  "compaction": {
    "auto": true,
    "keep": { "tokens": 12000 },
    "buffer": "20%"
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "@playwright/mcp@0.0.83",
        "--browser",
        "chromium",
        "--headless",
        "--no-sandbox"
      ],
      "enabled": true
    }
  }
}
