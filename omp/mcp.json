{
  "$schema": "https://raw.githubusercontent.com/can1357/oh-my-pi/main/packages/coding-agent/src/config/mcp-schema.json",
  "mcpServers": {
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "playwright": {
      "type": "stdio",
      "command": "playwright-mcp",
      "args": [
        "--browser",
        "chromium",
        "--headless",
        "--no-sandbox"
      ],
      "enabled": true,
      "timeout": 30000
    }
  }
}
